# Discord Bot Integration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Bot token from https://discord.com/developers/applications → Bot → Token
DISCORD_BOT_TOKEN=

# Public key from https://discord.com/developers/applications → General Information
DISCORD_PUBLIC_KEY=

# ID of the channel where watering reminders will be posted
# Right-click a channel in Discord → Copy Channel ID (requires Developer Mode)
DISCORD_CHANNEL_ID=

# ngrok tunnel (for stable Discord interactions endpoint in dev)
# Sign up at https://ngrok.com, then:
#   Dashboard → Domains → create a free static domain → copy it below (without https://)
#   Install the ngrok CLI: https://ngrok.com/download
NGROK_DOMAIN=
