# Discord Bot Integration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Bot token from https://discord.com/developers/applications → Bot → Token
DISCORD_BOT_TOKEN=

# Public key from https://discord.com/developers/applications → General Information
DISCORD_PUBLIC_KEY=

# Channel IDs for reminders — right-click a channel in Discord → Copy Channel ID (requires Developer Mode)
# Use separate channels to keep plant and household task notifications distinct.
DISCORD_PLANT_CHANNEL_ID=
DISCORD_TASK_CHANNEL_ID=

# Legacy fallback: if the specific channel IDs above are not set, both domains
# will fall back to this single channel (keeps old .env files working).
# DISCORD_CHANNEL_ID=

# Authentication
# Shared password for the household login gate
AUTH_PASSWORD=

# Random secret used as the session cookie value — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# ngrok tunnel (for stable Discord interactions endpoint in dev)
# Sign up at https://ngrok.com, then:
#   Dashboard → Domains → create a free static domain → copy it below (without https://)
#   Install the ngrok CLI: https://ngrok.com/download
NGROK_DOMAIN=

# Data export API
# Random key that external systems pass in the X-Api-Key header to access /api/export/*.
# Leave blank to disable the export endpoints entirely.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
EXPORT_API_KEY=
